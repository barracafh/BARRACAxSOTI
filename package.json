{
  "name": "buildnight-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun apps/server/src/index.ts",
    "dev": "bun apps/server/src/index.ts",
    "cli": "bun apps/cli/src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages tracks plantilla infra docs test e2e scripts .github *.json *.md",
    "format:check": "prettier --check apps packages tracks plantilla infra docs test e2e scripts .github *.json *.md",
    "check": "bun run typecheck && bun test && bun run format:check",
    "build:bin:host": "bun run --cwd apps/cli build:bin:host && bun run --cwd apps/server build:bin:host",
    "test:flujo": "NO_COLOR=1 bun test/support/flujo.ts",
    "test:live": "bun scripts/test-live.ts",
    "tracks:generar": "bun scripts/tracks.ts",
    "tracks:comprobar": "bun scripts/tracks.ts --check",
    "infografia:indice": "bun scripts/infografia.ts",
    "infografia:comprobar": "bun scripts/infografia.ts --check",
    "test:browser": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@buildnight/shared": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@playwright/test": "1.64.0",
    "@types/bun": "^1.3.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
