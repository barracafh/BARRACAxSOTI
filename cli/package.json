{
  "name": "barbaritat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "La ventanilla del hack BARRACA \u00d7 SOTI",
  "bin": {
    "barbaritat": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:bin:host": "bash scripts/build-all.sh --host",
    "build:bin": "bash scripts/build-all.sh",
    "embed-logo": "bun scripts/embed-logo.ts",
    "format": "prettier --write src test scripts/*.ts esquemas registro-base/*.json README.md web",
    "format:check": "prettier --check src test scripts/*.ts esquemas registro-base/*.json README.md web",
    "schema": "bun scripts/generate-schema.ts",
    "check": "bun run typecheck && bun test && bun run format:check",
    "start": "bun src/index.ts servidor",
    "test:flujo": "NO_COLOR=1 bun test/support/flujo.ts",
    "test:live": "bun scripts/test-live.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
