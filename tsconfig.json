{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "apps/cli/test/**/*.ts",
    "apps/cli/scripts/**/*.ts",
    "apps/server/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "infra/**/*.ts",
    "e2e/**/*.ts"
  ]
}
